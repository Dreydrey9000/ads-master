# Copy to .env.local and fill in what you have. Missing keys = that platform shows demo data.

# AI insights engine (OpenAI or Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI / ChatGPT Ads — Advertiser API key from Ads Manager > Settings
OPENAI_ADS_API_KEY=
OPENAI_ADS_ACCOUNT_ID=

# Meta Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=act_123,act_456

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_IDS=

# TikTok Marketing API
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_IDS=

# LinkedIn Marketing API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_IDS=

# Market research
FOREPLAY_API_KEY=

# ── Convex (database + sync) ──
# `npx convex dev` writes these to .env.local for you.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Set these on the Convex deployment (npx convex env set NAME value), not here:
#   OPENAI_API_KEY          AI insights (falls back to rule-based verdicts)
#   INSIGHTS_MODEL          optional, default gpt-4o-mini
#   OPENAI_ADS_API_BASE     optional override once ChatGPT Ads paths are verified
#   SALES_WEBHOOK_SECRET    shared secret for POST /sales-event
